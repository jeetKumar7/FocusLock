<?xml version="1.0" encoding="utf-8"?>
<!-- Only these apps are watched. Keep in sync with rules/ContentRules.kt. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:notificationTimeout="150"
    android:packageNames="com.instagram.android,com.google.android.youtube,com.facebook.katana,com.snapchat.android,com.twitter.android"
    android:description="@string/service_description" />
